# ReflexEngine Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Required: Fireworks AI API Key
# Get your API key from: https://fireworks.ai/
FIREWORKS_API_KEY=your_fireworks_api_key_here

# Optional: Model Configuration
# These models will be used for conscious and subconscious processing
CONSCIOUS_MODEL=accounts/fireworks/models/llama4-maverick-instruct-basic
SUBCONSCIOUS_MODEL=accounts/fireworks/models/llama4-scout-instruct-basic

# Optional: Debug Configuration
# Set to true to enable debug output (WARNING: may expose sensitive data)
DEBUG_MODE=false

# Optional: Memory Configuration
# MAX_NODES=10000
# STM_BUDGET=5000